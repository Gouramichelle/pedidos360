# Plantilla de infra/apps/.env — copiala y completa los valores.
#
#   cp infra/apps/.env.example infra/apps/.env
#
# El archivo real no se versiona: tiene la contrasena de la base y los
# identificadores del inquilino de Azure.
#
# Las cuatro variables marcadas como AUTOMATICAS las reescribe desplegar.sh con
# las direcciones de la sesion, asi que no hace falta mantenerlas a mano: lo que
# pongas aca solo sirve para levantar a mano sin pasar por el script.

# --------------------------------------------------------------- identidad
# De Azure AD > App registrations > Pedidos360 > Overview.
# El emisor lleva el Directory (tenant) ID y termina en /v2.0.
AZURE_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0

# Dos audiencias separadas por coma, y las dos hacen falta: Azure emite tokens
# v1 con aud "api://<application-id>" y v2 con el application-id pelado. Aceptar
# solo una da 401 silenciosos si cambia requestedAccessTokenVersion.
AZURE_AUDIENCES=api://<application-id>,<application-id>

# --------------------------------------------------------------- base de datos
# El endpoint de RDS, sin el puerto.
DB_HOST=<identificador>.<sufijo>.<region>.rds.amazonaws.com
DB_PORT=5432
DB_NAME=pedidos360
DB_USER=pedidos360_app
DB_PASSWORD=<la-que-pusiste-al-crear-la-instancia>

# update en el entorno academico: Hibernate crea esquemas y tablas al arrancar.
# En algo serio esto seria validate, con las migraciones aparte.
DDL_AUTO=update

# --------------------------------------------------------------- mensajeria
# Usuario del broker. guest/guest sirve porque el security group del broker solo
# acepta trafico desde las instancias de aplicacion, nunca desde internet. En un
# entorno real se crea un usuario propio y se borra guest.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# AUTOMATICA. Los dos nodos del cluster, separados por coma. Spring los intenta
# en orden y hace failover al segundo si el primero no responde.
RABBITMQ_ADDRESSES=<ip-privada-broker>:5672,<ip-privada-broker>:5673

# AUTOMATICA.
KAFKA_BOOTSTRAP_SERVERS=<ip-privada-broker>:9092

# --------------------------------------------------------------- CORS
# AUTOMATICA. Un solo origen: el del frontend desplegado. Nunca un comodin.
ALLOWED_ORIGINS=https://<ip-publica-apps>:8085
