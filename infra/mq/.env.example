# Copiar como .env en el host ec2-rabbit (queda fuera de git por infra/.gitignore).

# Secreto compartido con el que los dos nodos se autentican entre si.
# Generar uno propio con:
#   openssl rand -hex 32
RABBITMQ_ERLANG_COOKIE=reemplazar-por-una-cadena-aleatoria-larga

# Credenciales del broker. Se crean en los dos nodos por igual.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
